# Anthropic API (für die Lagebild-Synthese) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optionaler E-Mail-Versand via SMTP (leer lassen = nur Datei-Ausgabe in out/)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=lagebild@example.com

# Optionaler Telegram-Versand — https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Optionale Audio-Ausgabe (Lagebild zum Hören) via OpenAI TTS.
# https://platform.openai.com/api-keys — leer lassen = kein Audio.
OPENAI_API_KEY=

# Optionaler Web-Push für die PWA. Schlüsselpaar einmalig erzeugen mit:
#   python -m copilot.main vapid-keys
# Der Public-Key ist öffentlich (landet im Browser), der Private-Key bleibt geheim.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:unur@gmx.at

# Volltext-Fetcher für diepresse.com (optional).
# Cookie aus dem Browser kopieren: DevTools → Application → Cookies → diepresse.com
# Den gesamten Cookie-String einfügen (alle Cookies, nicht nur einen).
PRESSE_COOKIE=
